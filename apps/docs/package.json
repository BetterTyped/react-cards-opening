{
  "name": "@react-cards-opening/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/emit.mjs",
    "format": "pnpm --dir ../.. exec oxfmt --write apps/docs",
    "typecheck": "pnpm --dir ../.. exec tsgo -p apps/docs/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint apps/docs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@react-cards-opening/core": "workspace:*",
    "@react-cards-opening/effects": "workspace:*",
    "@react-cards-opening/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "gsap": "^3.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
