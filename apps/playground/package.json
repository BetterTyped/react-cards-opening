{
  "name": "@react-cards-opening/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "format": "pnpm --dir ../.. exec oxfmt --write apps/playground",
    "typecheck": "pnpm --dir ../.. exec tsgo -p apps/playground/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint apps/playground"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@react-cards-opening/core": "workspace:*",
    "@react-cards-opening/ui": "workspace:*",
    "gsap": "^3.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.2.4"
  }
}
