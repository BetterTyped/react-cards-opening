{
  "name": "@react-cards-opening/ui",
  "version": "1.0.0",
  "description": "Card opening components for React: a pack that bursts, a reel that spins, a case that opens and a scan that hunts, one reveal for all of them, and 64 effects from sparks to shockwaves. GSAP inside, one stylesheet, no CSS framework.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react-component",
    "cards",
    "card-opening",
    "pack-opening",
    "card-flip",
    "loot-box",
    "gacha",
    "rarity",
    "reveal",
    "trading-cards",
    "gamification",
    "animation",
    "gsap",
    "typescript",
    "case-opening",
    "particles",
    "confetti",
    "effects"
  ],
  "homepage": "https://bettertyped.github.io/react-cards-opening/",
  "bugs": "https://github.com/BetterTyped/react-cards-opening/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/react-cards-opening.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "format": "pnpm --dir ../.. exec oxfmt --write packages/ui",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/ui/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint packages/ui"
  },
  "peerDependencies": {
    "@react-cards-opening/core": "workspace:*",
    "gsap": "^3.13.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@react-cards-opening/core": "workspace:*"
  }
}
