{
  "name": "@react-cards-opening/effects",
  "version": "1.0.0",
  "description": "64 effects for React, made to be stacked: particles on a canvas (sparks, confetti, embers, flames), light (rays, flares, lightning, a sigil), shockwaves and screen effects (shake, glitch, impact frames). One name each. GSAP inside, one stylesheet.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "effects",
    "particles",
    "confetti",
    "fireworks",
    "shockwave",
    "screen-shake",
    "animation",
    "gsap",
    "canvas",
    "celebration",
    "gamification",
    "loot-box",
    "typescript"
  ],
  "homepage": "https://bettertyped.github.io/react-cards-opening/",
  "bugs": "https://github.com/BetterTyped/react-cards-opening/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/react-cards-opening.git",
    "directory": "packages/effects"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "format": "pnpm --dir ../.. exec oxfmt --write packages/effects",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/effects/tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint packages/effects"
  },
  "peerDependencies": {
    "gsap": "^3.13.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
